# Local practice defaults — everything runs on your laptop; nothing to request or provision.
# The two tokens below are FIXED DEMO VALUES shipped with the kit. Make your service read them
# from the environment (as this file does) so the contract tests and the harness work as-is.
PORT=8000
SELF_URL=http://localhost:8000
GATEWAY_URL=http://localhost:9100
TRAVEL_URL=http://localhost:9200
INVENTORY_URL=http://localhost:9300
HOSPITAL_TOKEN=hospital-token
COORDINATOR_TOKEN=coordinator-token
KIT_PATH=./participant_kit
